# Copy this file to .env and fill in real values for local development.
# .env is git-ignored; never commit real secrets.

# Application environment: dev, stage, or prod
APP_ENV=dev

# Google Gemini (AI Studio) API key for new-comedian discovery / vision extraction
GOOGLE_API_KEY=your_google_api_key_here

# Gmail SMTP for the weekly digest email (use a Gmail app password, not your login password)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Google Calendar OAuth client (downloaded from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret_here

# Google Cloud project for Firestore (prod state backend)
GCP_PROJECT_ID=your_gcp_project_id_here

# Shared token protecting the web UI
WEB_UI_TOKEN=your_web_ui_token_here
